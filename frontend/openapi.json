  "components": {
    "schemas": {
      "CaptureDefaults": {
        "properties": {
          "endpoint_path": {
            "type": "string",
            "title": "Endpoint Path"
          },
          "http_method": {
            "type": "string",
            "enum": [
              "PATCH",
              "POST"
            ],
            "title": "Http Method"
          },
          "body_template": {
            "type": "string",
            "title": "Body Template"
          },
          "placeholders": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Placeholders"
          }
        },
        "type": "object",
        "required": [
          "endpoint_path",
          "http_method",
          "body_template",
          "placeholders"
        ],
        "title": "CaptureDefaults"
      },
      "CaptureLinkInfo": {
        "properties": {
          "target_name": {
            "type": "string",
            "title": "Target Name"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "already_sent": {
            "type": "boolean",
            "title": "Already Sent"
          }
        },
        "type": "object",
        "required": [
          "target_name",
          "request_id",
          "already_sent"
        ],
        "title": "CaptureLinkInfo"
      },
      "CaptureOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "target_id": {
            "type": "integer",
            "title": "Target Id"
          },
          "target_name": {
            "type": "string",
            "title": "Target Name"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "accuracy": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy"
          },
          "location_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Error"
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          },
          "platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform"
          },
          "screen": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Screen"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "title": "Captured At"
          },
          "writeback_status": {
            "type": "string",
            "title": "Writeback Status"
          },
          "writeback_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Writeback Error"
          },
          "sent_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sent At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "target_id",
          "target_name",
          "request_id",
          "status",
          "latitude",
          "longitude",
          "accuracy",
          "location_error",
          "ip",
          "user_agent",
          "platform",
          "screen",
          "captured_at",
          "writeback_status",
          "writeback_error",
          "sent_at"
        ],
        "title": "CaptureOut"
      },
      "CaptureResult": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "message"
        ],
        "title": "CaptureResult"
      },
      "CaptureSubmit": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "captured",
              "denied",
              "unavailable"
            ],
            "title": "Status"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "accuracy": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy"
          },
          "location_error": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Error"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          },
          "platform": {
            "anyOf": [
              {
                "type": "string",
