# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXP_MINUTES=60

# Encrypts stored IFS credentials. Changing it makes saved secrets unreadable.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# SQLite file, or a Postgres URL (postgres://user:pass@host:5432/db also works).
DATABASE_URL=sqlite:///./atronexus.db

# Shared secret with the frontend. When set, the API refuses any request
# without it (except /api/health). Leave empty locally; required in production.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Created on startup if this user doesn't exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Optional: lets the admin sign in with this email and reset their password
ADMIN_EMAIL=

# The frontend's address; links in emails (verify, reset password) point here
APP_URL=http://localhost:3000
# console = print emails in the log (no sending). resend = send through resend.com
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=AtroNexus <no-reply@example.com>
